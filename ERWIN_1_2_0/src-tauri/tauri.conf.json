{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Erwin",
  "version": "0.1.0",
  "identifier": "com.localai.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Erwin",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:11434 https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co https://cdn-lfs.huggingface.co https://cas-bridge.xethub.hf.co",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../docs/VOICE_TROUBLESHOOTING_TH.md": "docs/VOICE_TROUBLESHOOTING_TH.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
